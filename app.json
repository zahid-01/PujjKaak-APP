{
  "expo": {
    "name": "PujjKaak",
    "slug": "PujjKaak",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo-DsY4IKTI.png",
    "scheme": "pujjkaak",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.PujjKaak"
    },
    "android": {
      "icon": "./assets/logo-DsY4IKTI.png",
      "adaptiveIcon": {
        "backgroundColor": "#E23744",
        "foregroundImage": "./assets/logo-DsY4IKTI.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.PujjKaak"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/logo-DsY4IKTI.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo-DsY4IKTI.png",
          "imageWidth": 250,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#1a1a1a",
            "image": "./assets/logo-DsY4IKTI.png"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
